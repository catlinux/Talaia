#!/bin/sh
# Post-installation script for talaia-agent.
set -eu

# Only configure on configure; ignore abort-* calls.
if [ "${1:-}" != "configure" ]; then
    exit 0
fi

CONFIG=/etc/talaia/agent.toml

if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
    systemctl daemon-reload || true
    systemctl enable talaia-agent || true

    if grep -Eq '^[[:space:]]*core_url[[:space:]]*=' "$CONFIG" 2>/dev/null; then
        systemctl restart talaia-agent || true
    else
        echo "talaia-agent: no core_url set in $CONFIG, the service was not started." >&2
        echo "talaia-agent: set core_url and run 'systemctl restart talaia-agent'." >&2
    fi
else
    echo "talaia-agent: systemd is not running, skipping the service setup." >&2
fi

exit 0
