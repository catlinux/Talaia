#!/bin/sh
# Post-removal script for talaia-agent.
set -eu

case "${1:-}" in
    remove|purge)
        if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
        fi
        ;;
esac

if [ "${1:-}" = "purge" ]; then
    rm -rf /etc/talaia
    rm -rf /var/lib/talaia
fi

exit 0
