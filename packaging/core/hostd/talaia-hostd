#!/usr/bin/env bash
#
# talaia-hostd applies the updates the core asks for. The core cannot touch
# Docker: it only writes {"target":"<sha>"} to <host_dir>/requests/update.json,
# and this helper, run as root by talaia-update.service, does the rest:
#
#   1. takes the request out of the core's reach and accepts nothing but a
#      40-hex commit that is on origin/main and ahead of the current one;
#   2. backs up the database, fast-forwards the clone and rebuilds the stack;
#   3. waits for /healthz and, if the new core does not answer, goes back to
#      the previous commit, restores the backup and rebuilds again.
#
# It writes its progress to <host_dir>/status.json, which the core reads.
#
# Usage: talaia-hostd update
#
# Configuration: /etc/talaia/hostd.conf (KEY=value lines, never sourced):
#   REPO_DIR        clone of the repository the core was installed from (required)
#   REPO_USER       owner of that clone; git runs as this user (required)
#   HOST_DIR        directory shared with the core (default /var/lib/talaia-host)
#   STATE_DIR       backups and lock, never shared (default /var/lib/talaia-hostd)
#   HEALTH_TIMEOUT  seconds to wait for the new core (default 180)
set -euo pipefail

CONF="${TALAIA_HOSTD_CONF:-/etc/talaia/hostd.conf}"
KEEP_BACKUPS=3
MAX_REQUEST_BYTES=256
MAX_LOG_LINES=40

REPO_DIR=""
REPO_USER=""
HOST_DIR="/var/lib/talaia-host"
STATE_DIR="/var/lib/talaia-hostd"
HEALTH_TIMEOUT=180

state="idle"
from=""
to=""
started_at=""
finished_at=""
log_lines=()

die() {
    echo "talaia-hostd: $*" >&2
    exit 1
}

now() {
    date -u +%Y-%m-%dT%H:%M:%SZ
}

is_root() {
    [ "$(id -u)" -eq 0 ]
}

# load_config reads the configuration without executing it: a value is only
# ever compared or used as a path or a user name after validation.
load_config() {
    [ -f "$CONF" ] || die "missing configuration $CONF"
    if is_root; then
        # A file anyone else can change would hand them root.
        [ "$(stat -c %u "$CONF")" -eq 0 ] || die "$CONF must be owned by root"
        case "$(stat -c %A "$CONF")" in
            ?????w???? | ????????w?) die "$CONF must not be writable by group or others" ;;
        esac
    fi

    local line key value
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in '' | '#'*) continue ;; esac
        key="${line%%=*}"
        value="${line#*=}"
        case "$key" in
            REPO_DIR) REPO_DIR="$value" ;;
            REPO_USER) REPO_USER="$value" ;;
            HOST_DIR) HOST_DIR="$value" ;;
            STATE_DIR) STATE_DIR="$value" ;;
            HEALTH_TIMEOUT) HEALTH_TIMEOUT="$value" ;;
            *) die "unknown key $key in $CONF" ;;
        esac
    done < "$CONF"

    local dir
    for dir in "$REPO_DIR" "$HOST_DIR" "$STATE_DIR"; do
        [[ "$dir" =~ ^/[A-Za-z0-9._/-]+$ ]] || die "invalid directory '$dir' in $CONF"
    done
    [[ "$REPO_USER" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || die "invalid REPO_USER in $CONF"
    [[ "$HEALTH_TIMEOUT" =~ ^[0-9]{1,4}$ ]] || die "invalid HEALTH_TIMEOUT in $CONF"
    [ -d "$REPO_DIR/.git" ] || die "$REPO_DIR is not a git clone"
}

# check_host_dir refuses a shared directory the core could rearrange: the core
# only owns requests/, everything else there is root's.
check_host_dir() {
    [ -d "$HOST_DIR" ] && [ ! -L "$HOST_DIR" ] || die "$HOST_DIR is not a directory"
    [ -d "$HOST_DIR/requests" ] && [ ! -L "$HOST_DIR/requests" ] || die "$HOST_DIR/requests is not a directory"
    if is_root; then
        [ "$(stat -c %u "$HOST_DIR")" -eq 0 ] || die "$HOST_DIR must be owned by root"
        case "$(stat -c %A "$HOST_DIR")" in
            ?????w???? | ????????w?) die "$HOST_DIR must not be writable by group or others" ;;
        esac
    fi
}

json_string() {
    local s="$1" out="" c i
    for ((i = 0; i < ${#s}; i++)); do
        c="${s:i:1}"
        case "$c" in
            '"') out+='\"' ;;
            '\') out+='\\' ;;
            $'\n') out+='\n' ;;
            $'\r') out+='\r' ;;
            $'\t') out+='\t' ;;
            [[:cntrl:]]) out+=' ' ;;
            *) out+="$c" ;;
        esac
    done
    printf '"%s"' "$out"
}

write_status() {
    local body line first=1 tmp
    body="{\"state\":$(json_string "$state"),\"from\":$(json_string "$from"),\"to\":$(json_string "$to")"
    body+=",\"started_at\":$(json_string "$started_at"),\"finished_at\":$(json_string "$finished_at"),\"log\":["
    for line in "${log_lines[@]}"; do
        [ "$first" -eq 1 ] || body+=","
        body+="$(json_string "$line")"
        first=0
    done
    body+="]}"

    # The directory is root's, so the rename cannot be redirected by the core.
    tmp="$(mktemp "$HOST_DIR/.status.XXXXXX")"
    printf '%s\n' "$body" > "$tmp"
    chmod 0644 "$tmp"
    mv -f -T "$tmp" "$HOST_DIR/status.json"
}

# say records a step for the panel and the journal. Only fixed messages and
# validated values go in: the panel shows them to the administrator.
say() {
    echo "talaia-hostd: $*"
    log_lines+=("$(date -u +%H:%M:%S) $*")
    if [ "${#log_lines[@]}" -gt "$MAX_LOG_LINES" ]; then
        log_lines=("${log_lines[@]:1}")
    fi
    write_status
}

finish() {
    state="$1"
    finished_at="$(now)"
    say "$2"
}

read_previous_status() {
    local file="$HOST_DIR/status.json"
    [ -f "$file" ] && [ ! -L "$file" ] || return 0
    [[ "$(head -c 4096 "$file")" =~ \"state\":\"([a-z_]+)\" ]] && state="${BASH_REMATCH[1]}"
    return 0
}

as_repo_user() {
    if is_root && [ "$REPO_USER" != root ]; then
        local home
        home="$(getent passwd "$REPO_USER" | cut -d: -f6)"
        runuser -u "$REPO_USER" -- env HOME="$home" GIT_TERMINAL_PROMPT=0 "$@"
    else
        GIT_TERMINAL_PROMPT=0 "$@"
    fi
}

git_repo() {
    as_repo_user git -C "$REPO_DIR" "$@"
}

compose() {
    (cd "$REPO_DIR/packaging/core" && docker compose "$@")
}

# panel_port reads the port from .env without sourcing it: that file belongs to
# REPO_USER and must not run as root.
panel_port() {
    local port
    port="$(sed -n 's/^TALAIA_PANEL_PORT=\([0-9]\{1,5\}\)[[:space:]]*$/\1/p' "$REPO_DIR/packaging/core/.env" | tail -n 1)"
    echo "${port:-8443}"
}

core_container() {
    compose ps -q core 2>/dev/null || true
}

wait_healthy() {
    local port deadline
    port="$(panel_port)"
    deadline=$((SECONDS + HEALTH_TIMEOUT))
    while [ "$SECONDS" -lt "$deadline" ]; do
        if curl -fsk --max-time 5 -o /dev/null "https://127.0.0.1:${port}/healthz"; then
            return 0
        fi
        sleep 3
    done
    return 1
}

# take_request moves the request into a directory only root can enter, then
# checks it there, where the core can no longer swap it for a link.
take_request() {
    local request="$HOST_DIR/requests/update.json" inbox="$HOST_DIR/.inbox" taken content
    [ -e "$request" ] || [ -L "$request" ] || return 1

    mkdir -p "$inbox"
    chmod 0700 "$inbox"
    taken="$inbox/update.json"
    rm -rf "$taken"
    mv -f -T "$request" "$taken"

    content=""
    if [ -f "$taken" ] && [ ! -L "$taken" ] && [ "$(stat -c %h "$taken")" -eq 1 ] &&
        [ "$(stat -c %s "$taken")" -le "$MAX_REQUEST_BYTES" ]; then
        content="$(head -c "$MAX_REQUEST_BYTES" "$taken")"
    fi
    rm -rf "$taken"

    if [[ "$content" =~ ^\{\"target\":\"([0-9a-f]{40})\"\}$ ]]; then
        to="${BASH_REMATCH[1]}"
    else
        to=""
    fi
    return 0
}

backup_database() {
    local file
    mkdir -p "$STATE_DIR/backups"
    chmod 0700 "$STATE_DIR" "$STATE_DIR/backups"
    file="$STATE_DIR/backups/talaia-$(date -u +%Y%m%dT%H%M%SZ)-${from:0:12}.sql.gz"
    # Only the public schema: restoring it whole also removes what a newer
    # migration added, so the old core finds the schema it expects.
    if ! (umask 077 && compose exec -T db pg_dump -U talaia -d talaia -n public | gzip > "$file") || [ ! -s "$file" ]; then
        rm -f "$file"
        return 1
    fi
    backup="$file"

    local old
    while IFS= read -r old; do
        rm -f "$old"
    done < <(ls -1t "$STATE_DIR"/backups/talaia-*.sql.gz 2>/dev/null | tail -n +$((KEEP_BACKUPS + 1)))
}

restore_database() {
    compose stop core || true
    # One transaction: a restore that fails leaves the database as it was.
    { echo 'DROP SCHEMA IF EXISTS public CASCADE;'; gunzip -c "$backup"; } |
        compose exec -T db psql -U talaia -d talaia -1 -q -v ON_ERROR_STOP=1 > /dev/null
}

rebuild() {
    TALAIA_GIT_COMMIT="$1" compose up -d --build
}

# roll_back returns to the previous commit; with restore it also puts back the
# database the new core may have migrated.
roll_back() {
    local restore="$1"
    say "going back to ${from:0:12}"
    if ! git_repo reset --keep "$from"; then
        finish failed "could not reset the repository to ${from:0:12}; fix it by hand"
        return
    fi
    if [ "$restore" = yes ]; then
        say "restoring the database backup"
        if ! restore_database; then
            finish failed "could not restore the database backup; it is in $backup"
            return
        fi
        say "rebuilding ${from:0:12}"
        if ! rebuild "$from" || ! wait_healthy; then
            finish failed "the previous version does not answer either; see journalctl -u talaia-update"
            return
        fi
    fi
    finish rolled_back "the update failed and ${from:0:12} is running again"
}

update() {
    load_config
    check_host_dir
    mkdir -p "$STATE_DIR"
    chmod 0700 "$STATE_DIR"

    exec 9> "$STATE_DIR/lock"
    flock -n 9 || exit 0

    if ! take_request; then
        # No request: a run that died half way (power cut, reboot) must not
        # leave the panel waiting for ever.
        read_previous_status
        if [ "$state" = running ]; then
            log_lines=()
            finish failed "the previous update was interrupted; check the repository and the stack"
        fi
        return 0
    fi

    state=running
    started_at="$(now)"
    from="$(git_repo rev-parse HEAD)"
    if [ -z "$to" ]; then
        finish failed "rejected: the request is not a valid update request"
        return 0
    fi
    say "update requested from ${from:0:12} to ${to:0:12}"

    if [ "$from" = "$to" ]; then
        finish succeeded "already at ${to:0:12}"
        return 0
    fi
    if [ "$(git_repo symbolic-ref --short -q HEAD || true)" != main ]; then
        finish failed "rejected: the clone in $REPO_DIR is not on the main branch"
        return 0
    fi
    if ! git_repo diff --quiet HEAD --; then
        finish failed "rejected: the clone in $REPO_DIR has local changes"
        return 0
    fi

    say "fetching origin main"
    if ! git_repo fetch --quiet origin main; then
        finish failed "could not fetch origin main"
        return 0
    fi
    if ! git_repo merge-base --is-ancestor "$to" origin/main 2> /dev/null; then
        finish failed "rejected: ${to:0:12} is not on origin/main"
        return 0
    fi
    if ! git_repo merge-base --is-ancestor "$from" "$to"; then
        finish failed "rejected: ${to:0:12} is not newer than ${from:0:12}"
        return 0
    fi

    say "backing up the database"
    backup=""
    if ! backup_database; then
        finish failed "could not back up the database; nothing was changed"
        return 0
    fi

    say "moving the clone to ${to:0:12}"
    if ! git_repo merge --ff-only --quiet "$to"; then
        finish failed "could not fast-forward to ${to:0:12}; nothing was changed"
        return 0
    fi

    local before after
    before="$(core_container)"
    say "building and starting ${to:0:12} (this takes a few minutes)"
    if ! rebuild "$to"; then
        after="$(core_container)"
        if [ -n "$before" ] && [ "$before" = "$after" ]; then
            # The build failed before Docker replaced anything: the old core
            # still runs on the old database.
            say "the build failed; the running core was not replaced"
            roll_back no
        else
            roll_back yes
        fi
        return 0
    fi

    say "waiting for the new core to answer"
    if ! wait_healthy; then
        say "the new core did not answer within ${HEALTH_TIMEOUT} s"
        roll_back yes
        return 0
    fi
    finish succeeded "updated to ${to:0:12}"
}

case "${1:-}" in
    update) update ;;
    *)
        echo "usage: talaia-hostd update" >&2
        exit 2
        ;;
esac
