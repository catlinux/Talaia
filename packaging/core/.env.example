# Copy this file to .env and fill it in. Docker Compose reads .env on its own.
# Never commit the real .env: it holds the database password.

# Password of the PostgreSQL user "talaia". It is part of TALAIA_DATABASE_URL,
# so it must be URL-safe: generate it as hexadecimal with
#   openssl rand -hex 32
POSTGRES_PASSWORD=

# Host name, or comma-separated host names, the panel is reached at. The core
# signs its own TLS certificate for them, so they must match the address in the
# browser: https://<name>/
TALAIA_PUBLIC_HOSTNAMES=talaia.example.com

# Host ports. The panel (browser, API, terminal) and the agents (stream,
# enrollment, downloads) use different ports; none of them needs 80 or 443.
TALAIA_PANEL_PORT=8443
TALAIA_AGENT_PORT=8444

# Trusted certificate for the panel by ACME DNS-01 (empty: the certificate of
# Talaia's own CA). Supported provider: ovh. The provider credentials go in
# .env.acme (mode 0600), which install.sh writes; see docs/en/installation.md.
TALAIA_ACME_PROVIDER=
TALAIA_ACME_EMAIL=

# Browser origins allowed to send changes to the API, comma separated.
# Leave it empty to derive them from TALAIA_PUBLIC_HOSTNAMES: https://<host> and,
# when the panel port is not 443, https://<host>:<port>.
# TALAIA_ALLOWED_ORIGINS=https://talaia.example.com

# Log level of the core: debug, info, warn or error.
# TALAIA_LOG_LEVEL=info
